{"lexicon" 1, "id" "com.etzhayyim.iriai.commonsFundingProposal", "defs" {"main" {"type" "record", "description" "A §1.16 social-security IN-KIND funding proposal for a lifeline-commons cell (ADR-2606272200). Funded on the non-profit rails: donation → TitheRouter 10% → Public Fund → grant/milestone-escrow/in-kind. Delivery is §1.16 in-kind: cash ≡ 0 to the consumer (G2) — a lifeline is a commons right, never billed, never disconnected for non-payment. iriai is a STEWARD, not a sovereign (G3): every proposal is advisory; the Public Fund (1 SBT = 1 vote) decides. The subaru 昴 in-kind precedent + Displacement-Dividend coupling.", "key" "tid", "record" {"type" "object", "required" ["region" "lifeline" "verdict" "instrument" "fundingSource" "delivery" "cashToConsumer" "advisory" "bindsFund" "decidedBy" "sourcing"], "properties" {"displacementDividendCoupled" {"type" "boolean", "const" true, "description" "build/ops labour freed by OSS robotics funds a tenure-weighted in-kind cohort pool (ADR-2606032130)"}, "fundingSource" {"type" "string", "const" "donation->tithe-10%->public-fund", "description" "G4 — non-profit rails only (USDC/Base/ERC-4337 or non-custodial fiat→USDC)"}, "regionName" {"type" "string", "maxLength" 512}, "cashToConsumer" {"type" "integer", "const" 0, "description" "G2 — cash ≡ 0; the consumer is never billed"}, "sourcing" {"type" "string", "enum" [":synthetic" ":authoritative"], "description" "G8 — :synthetic at R0"}, "delivery" {"type" "string", "const" "§1.16-social-security-in-kind", "description" "covenantal-universal in-kind delivery"}, "lifeline" {"type" "string", "enum" [":electric" ":water" ":gas" ":telecom"]}, "advisory" {"type" "boolean", "const" true, "description" "G3 — iriai proposes; it does not decide"}, "verdict" {"type" "string", "enum" [":provision" ":reinforce" ":redundancy"], "description" "only action verdicts are funded"}, "region" {"type" "string"}, "bindsFund" {"type" "boolean", "const" false, "description" "G3 — the Public Fund (1 SBT = 1 vote) decides, not iriai"}, "instrument" {"type" "string", "enum" [":grant" ":milestone-escrow" ":in-kind"], "description" "G2 — give-only instrument algebra; equity/debt/revenue-share/subscription unrepresentable"}, "decidedBy" {"type" "string", "const" "1-sbt-1-vote"}, "imputedAnnualUsd" {"type" "integer", "description" "market-equivalent annual worth of the in-kind delivery (aggregate, transparency-only) — proves the §1.16 income is HIGH while cash ≡ 0. NOT a price, NOT a bill."}, "reachPop" {"type" "integer", "description" "people the delivery reaches (provision reaches served + gap; aggregate, G1)"}}}}}}

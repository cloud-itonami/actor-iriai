{:paths ["src" "test"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.json"}
       ;; kotoba-lang/process, not babashka/process. Only ONE require needed it --
       ;; identity.cljc's seal-seed!. deploy/install.clj also uses babashka.process
       ;; but runs under `bb`, which bundles that namespace itself and never reads
       ;; this file, so it is unaffected (verified 2026-09-10).
       ;;
       ;; The two libraries differ where it counts here: p/shell THROWS on a
       ;; non-zero exit, exec fails closed with {:status N}. The call site now
       ;; checks :status; see seal-seed!'s docstring.
       io.github.kotoba-lang/process
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.process"}
}}

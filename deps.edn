{:paths ["src" "test"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/json {:git/sha "4c55a247b020bfb1c7b5b09f9df8f3fa5601a207"}
       ;; kotoba-lang/process, not babashka/process. Only ONE require needed it --
       ;; identity.cljc's seal-seed!. deploy/install.clj also uses babashka.process
       ;; but runs under `bb`, which bundles that namespace itself and never reads
       ;; this file, so it is unaffected (verified 2026-09-10).
       ;;
       ;; The two libraries differ where it counts here: p/shell THROWS on a
       ;; non-zero exit, exec fails closed with {:status N}. The call site now
       ;; checks :status; see seal-seed!'s docstring.
       io.github.kotoba-lang/process {:git/sha "759d0f9e660388c6d438192df99a6a236fa6ca9e"}
}}
